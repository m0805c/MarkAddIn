<UserControl x:Class="MarkAddIn.SavePrompt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MarkAddIn"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1024"
             Background="White">

    <Grid Width="954" Height="405" VerticalAlignment="Top" 
           Background="LightGray" Margin="0,20,0,0">


        <Grid Width="650" Height="360" VerticalAlignment="Top" Margin="0,30,0,0" Background="White">

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       FontSize="25"
                       FontWeight="DemiBold"
                       TextAlignment="Center"
                       Margin="0,25,0,0"
                       Text="¿Deseas guardar tu firma&#x0a; para su uso posterior?"> 
                
            </TextBlock>
            
            
            
            
                <!--aqui se tiene que mostrar la previsualización-->
            <Image x:Name="PreviewImage" Stretch ="Uniform" Width="400" Height="200" Margin="0,0,0,0"/>


            <Border BorderBrush="Gray" BorderThickness="3" CornerRadius="2">
            </Border>

            <Button Click="GuardarBtn_Click" 
                    Content= "Aceptar" 
                    Width="155"
                    Height="49"
                    FontSize="16"
                    FontWeight="DemiBold"
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Right" 
                    Margin="0,0,90,20">
            </Button>

            <Button Click="NoGuardarBtn_Click" 
                    Content="Cancelar"
                    Width="155"
                    Height="48"
                    FontSize="16"
                    FontWeight="DemiBold"
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Left" 
                    Margin="90,0,0,20">
            </Button>

        </Grid>
    </Grid>
</UserControl>
