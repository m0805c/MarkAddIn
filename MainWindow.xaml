<Window x:Class="MarkAddIn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markaddin="clr-namespace:MarkAddIn"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=markaddin:MainWindowViewModel}"
        Title="Mark"
        Width="1024"
        Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        BorderThickness="10"
        BorderBrush="LightSteelBlue"
        mc:Ignorable="d">

    <!-- Mapea VM -> View -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type markaddin:HomeViewViewModel}">
            <markaddin:HomeView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Define zonas: 0 barra superior fina, 1 header, 2-3 centro, 4 footer -->
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <!-- barra superior -->
            <RowDefinition Height="71"/>
            <!-- header -->
            <RowDefinition Height="3*"/>
            <!-- centro arriba -->
            <RowDefinition Height="7*"/>
            <!-- centro abajo -->
            <RowDefinition Height="65"/>
            <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Grid x:Name="UpTopGrid"
              Background="LightSteelBlue"
              Grid.Row="0"/>

        <!-- Header (SOLO en fila 1, sin RowSpan ni márgenes raros) -->
        <Grid x:Name="MainTopGrid"
              Background="LightGray"
              Grid.Row="1">
            <Image Source="C:\Users\andres.chavez\source\repos\MarkAddIn\Resources\Logo_Areya.png"
                   Width="180"
                   HorizontalAlignment="Left"
                   Margin="20,0,0,0"/>
            <Label x:Name="UsuarioLabel"
                   Content="{Binding Username}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="26"
                   FontWeight="DemiBold"
                   Foreground="Black"
                   Margin="0,0,70,0"/>
        </Grid>   
        
        <!--ContentControl -->
        
        <ContentControl Grid.Row="2"
                        Grid.RowSpan="2"
                        Content="{Binding CurrentView}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Margin="0"/>

        <!-- Footer -->
        <Grid x:Name="MainLowGrid"
              Background="LightGray"
              Grid.Row="4"/>
    </Grid>
</Window>


    