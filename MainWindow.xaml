<Window x:Class="MarkAddIn.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mark"
        Width="1024"
        Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        BorderThickness="10" BorderBrush="LightSteelBlue">


    <!-- Borde azul general de 2px -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="71"/>
            <RowDefinition/>
            <RowDefinition Height="65.04"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Grid x:Name="UpTopGrid" Background="LightSteelBlue" Grid.Row="0" Margin="-7,-7,-7,42"/>



        <!-- Usuario -->



        <Grid x:Name="MainTopGrid" Background="LightGray" Margin="0,0,0,33" Grid.RowSpan="2">




            <Label Content="Usuario"
         
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="20"
                       Foreground="Black"
                       Margin="0,0,70,0" 
                       
                       
                 />
        </Grid>

        <!-- Zona central con los paneles -->
        <Grid Grid.Row="1" Margin="0,45,0,27" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo -->
            <Grid x:Name="MainLeftGrid"
                      Width="432"
                      Background="LightGray"
                      HorizontalAlignment="Center" Margin="0,-2,0,-20">



                <Button x:Name="AprobacionBtn"
                            Content="Approve"
                            Width="144"
                            Height="49"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Margin="0,377,0,0"/>

            </Grid>

            <!-- Panel derecho -->
            <Grid x:Name="MainRightGrid"
                      Width="432"
                      Background="LightGray"
                      HorizontalAlignment="Center"
                      Grid.Column="1" Margin="0,-2,0,-20">



                <Button x:Name="FirmaBtn"
                            Content="Sign"
                            Width="144"
                            Height="41"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Margin="0,386,0,0" RenderTransformOrigin="0.609,-0.224" Click="FirmaBtn_Click"/>
            </Grid>
        </Grid>


        <!-- Pie de página -->

        <Grid x:Name="MainLowGrid"
              
                  Background="LightGray"
                  Grid.Row="3"/>
    </Grid>

</Window>